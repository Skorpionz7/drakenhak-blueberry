{
  "associatedLayout": "Game Position",
  "name": "Save Game Position",
  "events": [
    {
      "type": "BuiltinCommonInstructions::Standard",
      "conditions": [],
      "actions": [
        {
          "type": {
            "value": "SetNumberVariable"
          },
          "parameters": [
            "save_game.player_x",
            "=",
            "player_character.X()"
          ]
        },
        {
          "type": {
            "value": "SetNumberVariable"
          },
          "parameters": [
            "save_game.player_y",
            "=",
            "player_character.Y()"
          ]
        },
        {
          "type": {
            "value": "SetNumberVariable"
          },
          "parameters": [
            "save_game.player_rot",
            "=",
            "player_character.Angle()"
          ]
        },
        {
          "type": {
            "value": "SetNumberVariable"
          },
          "parameters": [
            "temp_i",
            "=",
            "0"
          ]
        }
      ]
    },
    {
      "type": "BuiltinCommonInstructions::Repeat",
      "repeatExpression": "butterfly_position.amount",
      "conditions": [],
      "actions": [
        {
          "type": {
            "value": "SetNumberVariable"
          },
          "parameters": [
            "temp_i",
            "+",
            "1"
          ]
        }
      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::ForEach",
          "object": "butterflys",
          "conditions": [
            {
              "type": {
                "value": "NumberVariable"
              },
              "parameters": [
                "temp_i",
                "=",
                "butterflys.id"
              ]
            }
          ],
          "actions": [
            {
              "type": {
                "value": "SetBooleanVariable"
              },
              "parameters": [
                "save_game.butterflys[temp_i][\"used\"]",
                "True",
                ""
              ]
            },
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "save_game.butterflys[temp_i][\"x\"]",
                "=",
                "butterflys.X()"
              ]
            },
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "save_game.butterflys[temp_i][\"y\"]",
                "=",
                "butterflys.Y()"
              ]
            }
          ]
        }
      ]
    }
  ]
}
